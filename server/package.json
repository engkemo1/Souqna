{
  "name": "@souqna/server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --no-warnings --env-file-if-exists=../.env src/index.js",
    "start": "node --no-warnings --env-file-if-exists=../.env src/index.js",
    "test:stylist": "node --test src/lib/stylist-ranking.test.js",
    "test:moda": "node --test test/moda.test.js",
    "test:visual": "node --test test/visual-taxonomy.test.js test/visual-search.test.js test/visual-integration.test.js test/visual-route.test.js test/visual-model-store.test.js test/visual-demand.test.js test/visual-eval.test.js test/visual-testset.test.js",
    "test:buyer-chats": "node --test test/buyer-chats.test.js",
    "test:market-cart": "node --test test/marketplace-cart.test.js",
    "evaluate:stylist": "node src/scripts/evaluate-stylist.js",
    "evaluate:stylist:external": "node src/scripts/evaluate-external-fashion.js",
    "seed": "node --no-warnings --env-file-if-exists=../.env src/db/seed.js",
    "boot": "node --no-warnings src/boot.js",
    "media:to-r2": "node --no-warnings --env-file-if-exists=../.env src/scripts/media-to-r2.js",
    "backup": "node --no-warnings --env-file-if-exists=../.env src/scripts/backup.js",
    "admin-totp": "node --no-warnings --env-file-if-exists=../.env src/scripts/admin-totp.js",
    "set-password": "node --no-warnings --env-file-if-exists=../.env src/scripts/set-password.js",
    "reprocess-media": "node --no-warnings --env-file-if-exists=../.env src/scripts/reprocess-media.js",
    "train:visual": "node --no-warnings --env-file-if-exists=../.env src/scripts/train-visual.js",
    "testset:visual": "node --no-warnings src/scripts/fetch-test-set.js",
    "compare:visual": "node --no-warnings --env-file-if-exists=../.env src/scripts/compare-visual-models.js",
    "model:prefetch": "node --no-warnings --env-file-if-exists=../.env src/scripts/download-clip-model.js"
  },
  "dependencies": {
    "@souqna/shared": "1.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.8.1"
  }
