  "rules": {
    "compose": [
      "ابدأ بالقطعة الرئيسية (hero) بتاعة الـlook، وبعدين كمّل الباقي.",
      "الفرق في الرسمية بين أي قطعتين في نفس الطقم مايزيدش عن درجة واحدة (مثال: مفيش بدلة مع كوتشي رياضي).",
      "لوحة ألوان من 2 لـ3 ألوان: أساسي + داعم + (اختياري) لمسة. الإكسسوار والحزام بياخدوا لون الحذاء أو الحقيبة.",
      "قطعة واحدة بس لافتة (طبعة أو لون جريء)، والباقي هادي.",
      "الحزام بنفس لون الحذاء في الأطقم الرسمية.",
      "الراحة مهمة في المناسبات اللي فيها قعدة طويلة أو رقص (اختار قصّة مريحة وحذاء يتحمل).",
      "الألوان اللي العميل قال إنه مابيحبهاش بتتشال من اللوحة حتى لو أنسب."
    ],
    "formality_match": "المنتج بيتقبل لو درجته جوه مدى الـlook (أو فرق درجة واحدة لو مفيش بديل). الدرجة بتيجي من formality_signals في taxonomy.json أو من اللي صاحب المحل حطه.",
    "near_white_guests": "في الفرح والخطوبة والضيف: ممنوع الأبيض والألوان القريبة منه (near_white). مسموح للعروسة أو لو الدعوة طلبت صراحة.",
    "couples": [
      "الاتنين في قصة ألوان واحدة (لوحة مشتركة أو متكاملة، مش نسخة طبق الأصل).",
      "الرجل بيختار كرافتة أو منديل أو حزام بلون فستان/عباية شريكته (سيدتي).",
      "الأطقم بتتعرض في تبويبين (ليك/ليها) وإجمالي لكل واحد وإجمالي الاتنين."
    ],
    "budget": [
      "الميزانية المذكورة دايمًا إجمالي. القطع المطلوبة (required) الأول، والاختيارية بتتحذف قبل ما نتخطى الميزانية.",
      "نسبة الميزانية لكل slot موجودة في الـlook، والكود بيعدّلها حسب المتاح.",
      "لو الإجمالي أعلى من الميزانية: نستبدل القطعة الأقل تأثيرًا بأرخص بديل، وفي الآخر نقول للعميل بوضوح إن الطقم زاد كام."
    ],
    "fallback_ladder": [
      "1) وسّع اللون لقريب منه في نفس اللوحة.",
      "2) وسّع السعر 15%.",
      "3) رسمية ±1 درجة.",
      "4) بديل من نفس العائلة (مثال: طقم كلاسيك بدل بدلة).",
      "5) لو لسه مفيش: اعرض الأجزاء اللي لقيناها ووضّح اللي ناقص مع زر 'اطلبه'، وماتجاملش."
    ],
    "never": [
      "العزاء (condolence): ما يظهرش في أي سؤال بأزرار ولا اقتراح ولا قائمة مناسبات. المحرك يستخدمه بس لو العميل كتب كلمة عزاء/جنازة صراحة (الكلمات في synonyms.contexts.condolence).",
      "ماتقترحش جلابية في فرح أو خطوبة إلا لو العميل طلبها أو اختار ذوق 'بلدي'.",
      "ماتقترحش ملابس داخلية ضمن أطقم. تعرضها بس لو اتطلبت صراحة.",
      "ماتحكمش على جسم العميل ولا تقول 'ده مش هيليق على جسمك'. اتكلم عن القصّة والخامة بس."
    ]
  },

